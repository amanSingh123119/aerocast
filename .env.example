# ==========================================
# AEROCAST - Environment Configuration
# Coupled AI Air Quality & Atmospheric Platform
# ==========================================

# 1. Supabase Database & Auth (PostgreSQL)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# 2. External Air Quality & Weather Ingestion APIs
# WAQI (World Air Quality Index - feeds real CPCB CAAQMS stations)
WAQI_API_TOKEN="your_waqi_api_token"
# OpenWeatherMap API for wind vector and boundary layer temperature
OPENWEATHER_API_KEY="your_openweather_key"
# SAFAR / IITM Coupled Dispersion Model Sync
SAFAR_IITM_API_KEY="your_safar_api_key"

# 3. Authentication (NextAuth / Google OAuth)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="aerocast_secure_random_session_secret"
GOOGLE_CLIENT_ID="your_google_oauth_client_id"
GOOGLE_CLIENT_SECRET="your_google_oauth_client_secret"

# 4. Citizen Automated Alerts (Resend / Email)
RESEND_API_KEY="re_your_resend_api_key"
ALERT_SENDER_EMAIL="alerts@aerocast.gov.in"
